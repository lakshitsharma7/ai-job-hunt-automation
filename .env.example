# ==============================================================================
# Autonomous AI Job Hunt Automation System — Environment Configuration
# Copy this file to .env and populate your environment-specific credentials.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Candidate Default Configuration
CANDIDATE_NAME="Your Full Name"
CANDIDATE_EMAIL="your.email@example.com"
CANDIDATE_PHONE="+91 9999999999"
CANDIDATE_CITY="Your City, India"

# Google Sheets Synchronization (Optional)
# Set your Google Spreadsheet ID (from the sheet URL)
GOOGLE_SPREADSHEET_ID=""
GOOGLE_SHEET_NAME="Job Hunt Tracker"
# Path to your Google Cloud service account JSON credentials
GOOGLE_SERVICE_ACCOUNT_FILE="config/google_service_account.json"

# Google Calendar Integration (Optional)
GOOGLE_CALENDAR_ID="primary"
INTERVIEW_WORK_HOURS_START="10:00"
INTERVIEW_WORK_HOURS_END="18:00"
INTERVIEW_TIMEZONE="Asia/Kolkata"

# Automated Cadence Settings
BATCH_SIZE=5
FIT_SCORE_THRESHOLD=60
AUTO_APPROVE_SUBMISSION=false

